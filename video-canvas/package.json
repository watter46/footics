{
  "name": "video-canvas-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:web": "vite --port 3000",
    "build": "wxt build && pnpm run sync-extension",
    "sync-extension": "mkdir -p /mnt/c/Users/nowat/extensions/$npm_package_name/ && cp -r .output/chrome-mv3/* /mnt/c/Users/nowat/extensions/$npm_package_name/",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "type-check": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "konva": "^10.3.0",
    "react-konva": "^19.2.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.306",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.0.7",
    "wxt": "^0.20.20"
  }
}
