{
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|manage_task",
        "hooks": [
          {
            "command": "node -e 'require(require(\"fs\").existsSync(\"./guards/safety-guard.js\") ? \"./guards/safety-guard.js\" : \"./.agents/guards/safety-guard.js\")'"
          }
        ]
      }
    ]
  },
  "oracle-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|write_to_file|replace_file_content",
        "hooks": [
          {
            "command": "node -e 'require(require(\"fs\").existsSync(\"./guards/oracle-guard.js\") ? \"./guards/oracle-guard.js\" : \"./.agents/guards/oracle-guard.js\")'"
          }
        ]
      }
    ]
  },
  "auto-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "command": "node -e 'require(require(\"fs\").existsSync(\"./guards/auto-format.js\") ? \"./guards/auto-format.js\" : \"./.agents/guards/auto-format.js\")'"
          }
        ]
      }
    ]
  },
  "verify-gate": {
    "Stop": [
      {
        "command": "node -e 'require(require(\"fs\").existsSync(\"./guards/verify-gate.js\") ? \"./guards/verify-gate.js\" : \"./.agents/guards/verify-gate.js\")'"
      }
    ]
  },
  "token-metrics": {
    "Stop": [
      {
        "command": "node -e 'require(require(\"fs\").existsSync(\"./scripts/metrics/collect-tokens.js\") ? \"./scripts/metrics/collect-tokens.js\" : \"./.agents/scripts/metrics/collect-tokens.js\")'"
      }
    ]
  }
}
