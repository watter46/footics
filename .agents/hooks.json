{
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "command": "node -e 'require(require(\"fs\").existsSync(\"./scripts/safety-guard.js\") ? \"./scripts/safety-guard.js\" : \"./.agents/scripts/safety-guard.js\")'"
          }
        ]
      }
    ]
  },
  "auto-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "command": "node -e 'require(require(\"fs\").existsSync(\"./scripts/auto-format.js\") ? \"./scripts/auto-format.js\" : \"./.agents/scripts/auto-format.js\")'"
          }
        ]
      }
    ]
  },
  "verify-gate": {
    "Stop": [
      {
        "command": "node -e 'require(require(\"fs\").existsSync(\"./scripts/verify-gate.js\") ? \"./scripts/verify-gate.js\" : \"./.agents/scripts/verify-gate.js\")'"
      }
    ]
  }
}
