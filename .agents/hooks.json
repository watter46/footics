{
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node guards/safety-guard.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
