{
  "token-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file|view_file|send_message",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./hooks/guard.ts",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "quality-gate": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./hooks/quality-gate.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
