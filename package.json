{
  "name": "footics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:cf": "npx @opennextjs/cloudflare build",
    "preview:cf": "pnpm build:cf && npx wrangler dev",
    "deploy": "rm -rf .next .open-next && pnpm build:cf && npx wrangler deploy",
    "preinstall": "npx only-allow pnpm",
    "devs": "npx next dev --experimental-https",
    "format": "biome format --write .",
    "lint": "rtk biome lint --write .",
    "check": "rtk biome check --write .",
    "type-check": "rtk tsc --noEmit",
    "verify": "rtk pnpm check && rtk pnpm type-check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "fuse.js": "^7.5.0",
    "hotkeys-js": "^4.0.3",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.5",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.80.1"
  }
}
