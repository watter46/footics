{
  "name": "footics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.0",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "dev": "next dev --turbo",
    "dev:https": "bun x next dev --experimental-https",
    "build": "rtk next build --skip-env",
    "deploy": "rm -rf .next .open-next && bunx @opennextjs/cloudflare build && bunx wrangler deploy",
    "extension:dev": "bun --cwd extension dev",
    "extension:build": "bun --cwd extension build",
    "ai:check": "bun .agents/scripts/check-worker.ts",
    "ai:reviewer:check": "bun .agents/scripts/check-reviewer.ts",
    "ai:preflight": "bun .agents/scripts/preflight.ts",
    "ai:commit": "bun .agents/scripts/commit.ts",
    "ai:report": "bun .agents/scripts/session-report.ts",
    "lint": "bun scripts/verify/lint.ts",
    "lint:fix": "bun scripts/verify/lint.ts --fix",
    "typecheck": "bun scripts/verify/type-check-scoped.ts",
    "test": "rtk vitest run",
    "test:agents": "bun test ./.agents",
    "map": "bun scripts/map/generate-repo-map.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "fuse.js": "^7.5.0",
    "gif.js": "^0.2.0",
    "gl-matrix": "^3.4.4",
    "hotkeys-js": "^4.0.3",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.31.0",
    "mp4-muxer": "^5.2.2",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.5",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "webm-muxer": "^5.1.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.3",
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.306",
    "@types/gif.js": "^0.2.5",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "dependency-cruiser": "^18.4.0",
    "fake-indexeddb": "^6.2.5",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "ripgrep": "^0.3.1",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "turbo": "^2.11.4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.80.1"
  }
}
