{
  "name": "footics-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "sync": "bun ../scripts/extension/sync-windows.ts",
    "dev:sync": "bun ../scripts/extension/sync-windows.ts --watch",
