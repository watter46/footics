    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "webext-bridge": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.306",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.46.2",
