{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "extension/**",
      "scripts/**",
      ".agents/scripts/**",
      ".agents/hooks/**",
      "tests/**",
      "biome.json",
      "package.json",
      "tsconfig.json"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "error",
        "useConst": "error",
        "useImportType": "error",
        "noParameterAssign": "warn",
        "noNestedTernary": "warn",
        "noRestrictedGlobals": {
          "level": "warn",
          "options": {
            "deniedGlobals": {
              "CustomEvent": "CustomEvent による暗黙連携は禁止です。Context / Ref または型付き postMessage を使用してください。"
            }
          }
        },
        "noNonNullAssertion": "warn",
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 300
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 100
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "performance": {
        "noDelete": "warn",
        "noReExportAll": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "off",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useButtonType": "warn",
        "noLabelWithoutControl": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noEmptyBlockStatements": "warn",
        "noReactForwardRef": "warn",
        "noTsIgnore": "warn",
        "noLeakedRender": "warn"
      },
      "nursery": {
        "useExhaustiveSwitchCases": "warn"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["**/extension/**/*"],
      "javascript": {
        "globals": [
          "browser",
          "chrome",
          "defineContentScript",
          "defineBackground",
          "defineUnlistedScript",
          "defineWxtModule",
          "import.meta"
        ]
      }
    },
    {
      "includes": [
        "src/lib/data/**",
        "src/lib/tactical/*-preset*.ts",
        "src/lib/types/tactical-unified.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", ".agents/**", "src/lib/agents/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
